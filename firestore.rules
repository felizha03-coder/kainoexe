rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedEmail() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'felizha03@gmail.com'
      );
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'shortDescription', 'technologies', 'featured']) &&
        data.keys().hasOnly([
          'id', 'slug', 'title', 'category', 'shortDescription', 'overview',
          'problemStatement', 'objectives', 'features', 'technologies',
          'developmentProcess', 'challengesAndSolutions', 'thumbnailUrl',
          'githubUrl', 'liveUrl', 'featured', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.category in ['Web Development', 'UI/UX Design', 'Academic Projects', 'Software Development', 'Experiments'] &&
        data.shortDescription is string && data.shortDescription.size() >= 1 && data.shortDescription.size() <= 400 &&
        data.technologies is list && data.technologies.size() <= 20 &&
        (data.technologies.size() == 0 || data.technologies[0] is string) &&
        data.featured is bool;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'excerpt', 'content', 'published']) &&
        data.keys().hasOnly([
          'id', 'slug', 'title', 'category', 'excerpt', 'content',
          'readingTimeMin', 'publishedAt', 'published', 'featured'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.category in ['Programming', 'Technology', 'AI', 'Web Development', 'Student Life', 'Tutorials'] &&
        data.excerpt is string && data.excerpt.size() >= 1 && data.excerpt.size() <= 400 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 15000 &&
        data.published is bool;
    }

    function isValidLearningResource(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'level', 'summary', 'content']) &&
        data.keys().hasOnly([
          'id', 'title', 'category', 'level', 'readingTimeMin',
          'summary', 'content', 'keyTakeaways', 'roadmapId'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.level in ['Beginner', 'Intermediate', 'Advanced'] &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 400 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 15000;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 4000 &&
        data.createdAt == request.time;
    }

    function isValidSiteSetting(data) {
      return data.keys().hasAll(['key']) &&
        data.key is string && data.key.size() >= 1 && data.key.size() <= 64;
    }

    match /test/connection {
      allow get: if true;
    }

    match /projects/{projectId} {
      allow list: if true;
      allow get: if isValidId(projectId);
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(projectId);
    }

    match /blog_posts/{postId} {
      allow list: if existing().published == true || isAdmin();
      allow get: if isValidId(postId) && (existing().published == true || isAdmin());
      allow create: if isAdmin() && isValidId(postId) && isValidBlogPost(incoming());
      allow update: if isAdmin() && isValidId(postId) && isValidBlogPost(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(postId);
    }

    match /learning_resources/{resourceId} {
      allow list: if true;
      allow get: if isValidId(resourceId);
      allow create: if isAdmin() && isValidId(resourceId) && isValidLearningResource(incoming());
      allow update: if isAdmin() && isValidId(resourceId) && isValidLearningResource(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(resourceId);
    }

    match /site_settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public_profile' || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidSiteSetting(incoming());
      allow delete: if false;
    }

    match /contact_messages/{messageId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow update, delete: if isAdmin() && isValidId(messageId);
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
